# ============================================
# ResQ Live — Config Environment Example
# ============================================
# Shared configuration constants

# ============================================
# Application Constants
# ============================================
APP_NAME=ResQ Live
APP_VERSION=1.0.0
API_VERSION=v1
API_PREFIX=api/v1

# ============================================
# Pagination Defaults
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# Date/Time Formats
# ============================================
ISO_DATE_FORMAT=YYYY-MM-DDTHH:mm:ss.SSSZ
DISPLAY_DATE_FORMAT=YYYY-MM-DD HH:mm:ss