# ============================================
# ResQ Live — Sync Client Environment Example
# ============================================
# Shared sync protocol client (used by mobile, desktop, EOC)

# ============================================
# Sync Configuration
# ============================================
SYNC_API_BASE_URL=http://localhost:3000/api/v1
SYNC_OUTBOX_BATCH_SIZE=50
SYNC_INBOX_BATCH_SIZE=50
SYNC_POLL_INTERVAL_MS=30000
SYNC_MAX_RETRIES=3
SYNC_RETRY_BASE_DELAY_MS=5000
SYNC_CURSOR_STORAGE_KEY=resq_sync_cursor

# ============================================
# Conflict Resolution
# ============================================
SYNC_CONFLICT_RESOLUTION=server_wins
SYNC_CONFLICT_RETENTION_DAYS=30

# ============================================
# Offline Storage
# ============================================
SYNC_OFFLINE_DB_NAME=resq-sync-offline
SYNC_OFFLINE_DB_VERSION=1