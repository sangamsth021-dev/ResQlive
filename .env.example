# ============================================
# ResQ Live — Root Environment Example
# ============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local or any .env file with real credentials

# ============================================
# Monorepo / Turbo
# ============================================
TURBO_TEAM=your-team-slug
TURBO_TOKEN=your-turbo-token

# ============================================
# Shared: Database (used by backend + migrations)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=resq_live_dev

# ============================================
# Shared: PostgreSQL/PostGIS (for local dev with Docker)
# ============================================
# If using docker-compose for database:
# DB_HOST=localhost
# DB_PORT=5432

# ============================================
# Shared: Redis (for BullMQ workers, caching, sessions)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Shared: MinIO / S3 Object Storage (for evidence uploads)
# ============================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resq-evidence
S3_PUBLIC_URL=http://localhost:9000/resq-evidence

# ============================================
# Shared: JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=resq-live
JWT_AUDIENCE=resq-live-api

# ============================================
# Shared: Application
# ============================================
NODE_ENV=development
LOG_LEVEL=debug
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173