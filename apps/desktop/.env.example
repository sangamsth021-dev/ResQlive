# ============================================
# ResQ Live — Desktop (Electron) Environment Example
# ============================================
# Copy to .env.local and configure
# DO NOT commit .env.local or files with real credentials

# ============================================
# Electron / Build
# ============================================
ELECTRON_ENABLE_LOGGING=true
ELECTRON_LOG_LEVEL=debug

# ============================================
# Database (SQLite for local offline storage)
# ============================================
DESKTOP_DB_PATH=./data/resq-desktop.db
DESKTOP_DB_ENCRYPTION_KEY=your-desktop-encryption-key-change-in-production

# ============================================
# Sync Configuration (shared sync client)
# ============================================
VITE_API_BASE_URL=http://localhost:3000/api/v1
SYNC_OUTBOX_BATCH_SIZE=50
SYNC_POLL_INTERVAL_MS=60000
SYNC_MAX_RETRIES=3
SYNC_RETRY_BASE_DELAY_MS=5000

# ============================================
# Local Storage Paths
# ============================================
EVIDENCE_LOCAL_PATH=./data/evidence
REPORTS_LOCAL_PATH=./data/reports
OUTBOX_LOCAL_PATH=./data/outbox

# ============================================
# Camera / Media Capture
# ============================================
DESKTOP_CAMERA_DEVICE_ID=
DESKTOP_MAX_VIDEO_DURATION_SEC=300
DESKTOP_MAX_PHOTO_SIZE_MB=20

# ============================================
# Security
# ============================================
DESKTOP_AUTO_LOCK_MINUTES=15
DESKTOP_SESSION_TIMEOUT_HOURS=8