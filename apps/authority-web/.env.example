# ============================================
# ResQ Live — Authority Web Environment Example
# ============================================
# Copy to .env.local and configure
# DO NOT commit .env.local or files with real credentials

# ============================================
# Vite / Build
# ============================================
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_TITLE=ResQ Live Authority
VITE_APP_VERSION=1.0.0-dev

# ============================================
# Feature Flags
# ============================================
VITE_ENABLE_OFFLINE_MODE=false
VITE_ENABLE_DEBUG_PANEL=false
VITE_ENABLE_MOCK_API=false

# ============================================
# Map / Location
# ============================================
VITE_MAP_DEFAULT_CENTER_LAT=37.7749
VITE_MAP_DEFAULT_CENTER_LNG=-122.4194
VITE_MAP_DEFAULT_ZOOM=12
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ============================================
# Authentication (frontend only - backend validates)
# ============================================
VITE_AUTH_TOKEN_KEY=resq_auth_token
VITE_AUTH_USER_KEY=resq_auth_user
VITE_TOKEN_REFRESH_BUFFER_MS=300000

# ============================================
# Sync / Offline
# ============================================
VITE_SYNC_POLL_INTERVAL_MS=30000
VITE_MAX_OFFLINE_REPORTS=100
VITE_OFFLINE_STORAGE_KEY=resq_offline_reports

# ============================================
# Evidence / Media
# ============================================
VITE_MAX_EVIDENCE_SIZE_MB=50
VITE_ALLOWED_EVIDENCE_TYPES=image/jpeg,image/png,video/mp4,audio/mpeg,application/pdf

# ============================================
# External Services (public keys only)
# ============================================
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=