# ============================================
# ResQ Live — Backend Environment Example
# ============================================
# Copy to .env.local and configure
# DO NOT commit .env.local or files with real credentials

# ============================================
# Server
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Database (PostgreSQL + PostGIS)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=resq_live_dev

# ============================================
# Redis (BullMQ, caching, rate limiting)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# MinIO / S3 Object Storage (evidence uploads)
# ============================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resq-evidence
S3_PUBLIC_URL=http://localhost:9000/resq-evidence

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=resq-live
JWT_AUDIENCE=resq-live-api

# ============================================
# Authentication / OTP
# ============================================
OTP_EXPIRES_IN=5m
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3

# ============================================
# Device Registration
# ============================================
DEVICE_REGISTRATION_ENABLED=true
DEVICE_PUBLIC_KEY_ALGORITHM=ED25519
DEVICE_MAX_PER_USER=5

# ============================================
# Sync Configuration
# ============================================
SYNC_OUTBOX_BATCH_SIZE=100
SYNC_INBOX_BATCH_SIZE=100
SYNC_CURSOR_RETENTION_DAYS=30
SYNC_CONFLICT_RESOLUTION=server_wins

# ============================================
# Notifications
# ============================================
NOTIFICATION_PROVIDERS=fcm,twilio,smtp
FCM_CREDENTIALS_PATH=./config/firebase-credentials.json
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@resq.live

# ============================================
# OpenTelemetry / Observability
# ============================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=resq-backend
OTEL_TRACES_SAMPLER=always_on

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ============================================
# Test Configuration (for CI)
# ============================================
# DB_NAME=resq_live_test
# JWT_SECRET=test-secret-key-for-ci